{
  "name": "douren-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "../../scripts/infisical-headless.sh run --env=dev -- vite",
    "build": "pnpm run sitemap:generate:auto && vite build",
    "lint": "eslint ./src --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "format": "prettier ./src --write --single-quote false --semi true",
    "test": "vitest run",
    "sitemap:generate:auto": "if [ \"$CI\" = \"true\" ]; then pnpm run sitemap:generate:ci; else pnpm run sitemap:generate; fi",
    "sitemap:generate": "../../scripts/infisical-headless.sh run --env=prod -- node ./scripts/generate-sitemap.mjs",
    "sitemap:generate:ci": "node ./scripts/generate-sitemap.mjs"
  },
  "dependencies": {
    "@mantine/hooks": "^9.8.2",
    "@pkg/edge-auth": "workspace:*",
    "@tanstack/react-query": "^5.108.2",
    "@tanstack/react-router": "^1.170.46",
    "@trpc/client": "^11.29.7",
    "@trpc/react-query": "^11.29.7",
    "@trpc/server": "^11.29.7",
    "classnames": "^2.5.1",
    "framer-motion": "^14.14.0",
    "immer": "^11.2.10",
    "lucide-react": "^1.77.0",
    "normalize.css": "^8.0.1",
    "posthog-js": "^1.453.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-lazy-load-image-component": "^1.6.3",
    "react-responsive-masonry": "^2.9.0",
    "tailwindcss": "^4.3.5",
    "use-immer": "^0.11.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@babel/core": "^8.1.3",
    "@be/douren-backend": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/router-cli": "^1.168.0",
    "@tanstack/router-devtools": "^1.167.4",
    "@tanstack/router-plugin": "^1.169.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
