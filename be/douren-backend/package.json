{
  "name": "@be/douren-backend",
  "version": "0.0.1",
  "scripts": {
    "dev": "../../scripts/infisical-headless.sh export > .dev.vars && wrangler dev src/index.ts --port 2000",
    "preview": "../../scripts/infisical-headless.sh export > .dev.vars && wrangler dev src/index.ts --port 2000 --local",
    "deploy": "wrangler deploy --minify src/index.ts",
    "cron-test": "wrangler dev src/index.ts --test-scheduled --port 2000",
    "build": "tsc",
    "build:pkg": "tsc",
    "format": "npx @biomejs/biome format --write ./src",
    "lint": "npx @biomejs/biome lint --write ./src ",
    "test": "vitest run"
  },
  "exports": {
    "./api": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.6.2",
    "@hono/trpc-server": "^0.4.2",
    "@hono/zod-openapi": "^1.6.3",
    "@pkg/database": "workspace:*",
    "@pkg/type": "workspace:*",
    "@trpc/server": "11.29.7",
    "better-auth": "^1.7.27",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.13.19",
    "lru-cache": "^11.5.3",
    "resend": "^6.39.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261121.1",
    "@pkg/env": "workspace:*",
    "@pkg/typescript-config": "workspace:*",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  }
}
