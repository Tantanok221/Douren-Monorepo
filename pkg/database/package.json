{
  "name": "@pkg/database",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "build": "pnpm run codegen && rimraf dist && tsc",
    "build:pkg": "pnpm run codegen && rimraf dist && tsc",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:introspect": "drizzle-kit introspect --config=drizzle.config.ts",
    "db:push": "drizzle-kit push",
    "codegen": "rimraf src/zod && node generateZodSchema.js"
  },
  "exports": {
    "./db": {
      "types": "./src/db/index.ts",
      "default": "./dist/db/index.js"
    },
    "./helper": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./zod": {
      "types": "./src/zod/index.ts",
      "default": "./dist/zod/index.js"
    }
  },
  "devDependencies": {
    "@pkg/typescript-config": "workspace:*",
    "code-block-writer": "^13.0.3",
    "drizzle-kit": "^0.31.11",
    "esbuild": "0.28.2",
    "esbuild-plugin-tsc": "^0.6.0",
    "rimraf": "^6.1.4",
    "ts-morph": "^28.0.0"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.8.3",
    "postgres": "^4.1.1",
    "zod": "^4.6.7"
  }
}
